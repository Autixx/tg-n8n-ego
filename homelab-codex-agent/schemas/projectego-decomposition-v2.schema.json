{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectEGO Decomposition Result V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "source_summary", "needs_clarification", "eventlog_summary"],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["abstract_idea", "structured_breakdown", "create_tasks", "advisor"]
    },
    "source_summary": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "type",
          "domain_hint",
          "module_hint",
          "summary",
          "details",
          "source_text",
          "priority",
          "labels",
          "dependencies",
          "acceptance_criteria",
          "needs_clarification"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["idea", "task", "bug", "research", "decision"]
          },
          "domain_hint": {
            "type": "string",
            "enum": ["core", "combat", "enemies", "biomorph", "world", "narrative", "items", "presentation", "tech", "parking"]
          },
          "module_hint": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "needs_clarification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "answer_markdown": {
      "type": "string"
    },
    "key_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_clarification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "eventlog_summary": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "advisor"
          }
        }
      },
      "then": {
        "required": ["answer_markdown", "key_points", "suggested_next_actions"]
      },
      "else": {
        "required": ["items"]
      }
    }
  ]
}
